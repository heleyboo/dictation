# Single origin: SPA static files + /api reverse proxy (no CORS needed).
# Local compose listens on :80 inside the container; production adds the real domain for automatic TLS.
{
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Hashed Vite assets never change → cache forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
