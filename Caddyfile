# Single origin: SPA static files + /api reverse proxy (no CORS needed).
# Local compose listens on :80 inside the container; production adds the real domain for automatic TLS.
{
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Cap request bodies before they reach the API: FastAPI parses (and spools) a multipart body before
	# auth dependencies run, so an unauthenticated client could otherwise fill the disk.
	@lessonUpload path /api/v1/admin/lessons
	request_body @lessonUpload {
		max_size 31MB
	}
	@apiSmallBody {
		path /api/*
		not path /api/v1/admin/lessons
	}
	request_body @apiSmallBody {
		max_size 1MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Hashed Vite assets never change → cache forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
