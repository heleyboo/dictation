# Copy to .env and fill in. Never commit .env.
# Variables marked (phase N) are read starting from that phase of plans/260918-1535-dictation-mvp.

# --- Docker Compose host ports (change if they clash with other local projects) ---
POSTGRES_HOST_PORT=5434
WEB_HOST_PORT=8080
POSTGRES_PASSWORD=dictation

# --- API / worker ---
# Local dev (api run outside Docker). Inside compose this is set by docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://dictation:dictation@localhost:5434/dictation
WORKER_POLL_INTERVAL=2
WORKER_LOCK_TIMEOUT=900
# Test suite database (created automatically by deploy/postgres-init).
TEST_DATABASE_URL=postgresql+asyncpg://dictation:dictation@localhost:5434/dictation_test

# --- App (phase 2) ---
# https:// here ⇒ Secure cookies + SESSION_SECRET required (the API refuses to start otherwise).
APP_BASE_URL=http://localhost:8080
# Long random string in production: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth redirect URI to register: {APP_BASE_URL}/api/v1/auth/google/callback
MAGIC_LINK_ENABLED=false

# --- LLM (phase 2) ---
ANTHROPIC_API_KEY=
# Word lookup (fast, frequent)
LLM_MODEL=claude-haiku-4-5
# Sentence translation when a lesson is ingested (once per lesson, quality first)
TRANSLATE_MODEL=claude-sonnet-5

# --- Audio storage, S3-compatible: minio locally (defaults below), Cloudflare R2 in prod ---
# Bucket must allow public reads with HTTP Range (browser streams + seeks the audio).
MINIO_HOST_PORT=9010
S3_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=dictation-audio
S3_ACCESS_KEY_ID=dictation
S3_SECRET_ACCESS_KEY=dictation-dev-secret
S3_REGION=auto
S3_PUBLIC_BASE_URL=http://localhost:9010/dictation-audio

# --- Email (phase 2 magic link, phase 5 reminders) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REMINDERS_ENABLED=false
